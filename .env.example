# ==============================================================================
# Enterprise AI Document Intelligence & Advanced RAG Environment Config
# ==============================================================================

APP_NAME=EDI-GLOBE Enterprise AI Platform
ENV=development
DEBUG=true
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Relational DB (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edi_globe
POSTGRES_DB=edi_globe
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=edi_documents

# Embedding Model (BGE-M3)
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DEVICE=auto
EMBED_BATCH_SIZE=32

# Reranker Model (BGE-Reranker-v2-m3)
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_TOP_N=10

# Primary Generation LLM (Qwen3-8B)
LLM_MODEL_NAME=Qwen/Qwen3-8B
LLM_DEVICE=auto
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# Search & Fusion Parameters
BM25_TOP_K=20
HYBRID_RRF_K=60
VECTOR_TOP_K=20

# Smart Chunking Configuration
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
SENTENCE_MIN_LEN=10

# Security & RBAC
SECRET_KEY=change-this-to-a-super-secret-32-character-key-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=1440

# Upload Limits
MAX_UPLOAD_SIZE_MB=50

# Admin Defaults
ADMIN_DEFAULT_EMAIL=admin@edi-globe.local
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
